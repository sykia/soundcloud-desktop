{
  "name": "soundcloud-desktop",
  "version": "0.5.5-debug.1",
  "private": true,
  "description": "SoundCloud desktop client with offline Russian interface translation and customization",
  "author": {
    "name": "cusae",
    "email": "cusae@mail.ru"
  },
  "homepage": "https://github.com/sykia/soundcloud-desktop",
  "desktopName": "io.github.sykia.soundcloud-desktop.desktop",
  "main": "src/main/index.js",
  "scripts": {
    "start": "node build.js && electron .",
    "check": "node scripts/check-consistency.js",
    "test": "node --test scripts/localization.test.js scripts/localization.integration.test.js scripts/frame-localization.test.js scripts/catalog-generation.test.js scripts/linux-package-install.test.js scripts/downloads.test.js scripts/nix-updates.test.js",
    "test:ui": "node build.js && electron scripts/ui-smoke.js",
    "electron:install": "install-electron --no",
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "localization:capture": "node build.js && electron . --capture-localization=/tmp/soundcloud-labels.jsonl",
    "localization:generate": "node scripts/generate-localization-catalog.js",
    "predist:linux": "node build.js",
    "dist:linux": "electron-builder --linux AppImage deb rpm pacman --x64 --publish never",
    "predist:win": "node build.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "install:nixos": "node scripts/install-nixos.js"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "io.github.sykia.soundcloud-desktop",
    "productName": "SoundCloud Desktop",
    "publish": [
      {
        "provider": "github",
        "owner": "sykia",
        "repo": "soundcloud-desktop"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "shared/**",
      "dist-js/**",
      "package.json",
      "build/icons/*",
      "build/icon.ico",
      "build/icon-styles/*"
    ],
    "extraResources": [
      {
        "from": "build/translation-engine",
        "to": "translation-engine"
      },
      {
        "from": "build/translation-model",
        "to": "translation-model"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "mimeTypes": [
        "x-scheme-handler/soundcloud-desktop"
      ],
      "icon": "build/icons",
      "category": "AudioVideo",
      "synopsis": "SoundCloud desktop client",
      "executableName": "soundcloud-desktop",
      "syncDesktopName": true
    },
    "pacman": {
      "compression": "zstd",
      "artifactName": "soundcloud-desktop-${version}-1-x86_64.pkg.tar.zst",
      "depends": [
        "gtk3",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ]
    },
    "appImage": {
      "artifactName": "SoundCloud-Desktop-${version}-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "soundcloud-desktop_${version}_amd64.deb"
    },
    "rpm": {
      "artifactName": "soundcloud-desktop-${version}-1.x86_64.rpm"
    },
    "win": {
      "target": "nsis",
      "protocols": [
        {
          "name": "SoundCloud Desktop",
          "schemes": [
            "soundcloud-desktop"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "SoundCloud Desktop"
    },
    "nsis": {
      "artifactName": "SoundCloud-Desktop-Setup-${version}-x64.${ext}",
      "oneClick": false,
      "differentialPackage": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundCloud Desktop"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "semver": "7.8.5"
  }
}
