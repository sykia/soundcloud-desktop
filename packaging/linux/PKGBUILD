pkgname=scrip
pkgver=1.4.0
pkgrel=1
license=('GPL-3.0-only')
pkgdesc='Настольный плеер для SoundCloud'
arch=('x86_64')
url='https://github.com/sykia/SCrip'
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-multimedia-ffmpeg')
makedepends=('cmake' 'ninja')
_commit=645f1876b99346e1de5c4efd30a42e3d1e050ad3
source=("SCrip-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('119624bfd8b970cfb134a20040094a1069d15261955ac08a67a5d653a1f5d3a7')
build() {
    cmake -S "SCrip-$_commit" -B build -G Ninja -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release
    cmake --build build --parallel 2
}
package() {
    install -Dm644 "SCrip-$_commit/LICENSE" "$pkgdir/usr/share/licenses/scrip/LICENSE"
    install -Dm644 "SCrip-$_commit/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/doc/scrip/THIRD_PARTY_NOTICES.md"
    install -Dm644 "SCrip-$_commit/TRADEMARKS.md" "$pkgdir/usr/share/doc/scrip/TRADEMARKS.md"
    install -Dm755 build/scrip "$pkgdir/usr/bin/scrip"
    install -Dm644 "SCrip-$_commit/packaging/linux/scrip.desktop" "$pkgdir/usr/share/applications/scrip.desktop"
    install -Dm644 "SCrip-$_commit/packaging/linux/scrip.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/scrip.png"
}
