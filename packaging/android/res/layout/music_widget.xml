<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="6dp">
    <LinearLayout android:id="@+id/widget_info" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/widget_cover" android:layout_width="36dp" android:layout_height="36dp" android:scaleType="fitCenter" android:src="@drawable/icon" android:contentDescription="Обложка трека" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SCrip" android:textColor="#171619" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Включи музыку в приложении" android:textColor="#69656b" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        </LinearLayout>
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_wave" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="18dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_elapsed" android:layout_width="32dp" android:layout_height="wrap_content" android:text="0:00" android:textColor="#77717a" android:textSize="9sp" android:includeFontPadding="false" />
        <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="3dp" android:progressDrawable="@drawable/widget_progress" android:indeterminate="false" android:max="1000" />
        <TextView android:id="@+id/widget_remaining" android:layout_width="36dp" android:layout_height="wrap_content" android:gravity="right" android:text="−0:00" android:textColor="#77717a" android:textSize="9sp" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="1dp" android:importantForAccessibility="no" />
        <ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:padding="10dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_previous" android:scaleType="fitCenter" android:contentDescription="Предыдущий трек" />
        <ImageButton android:id="@+id/widget_play" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:padding="7dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_play" android:scaleType="fitCenter" android:contentDescription="Воспроизвести" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:padding="10dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_next" android:scaleType="fitCenter" android:contentDescription="Следующий трек" />
        <ImageButton android:id="@+id/widget_output" android:layout_width="34dp" android:layout_height="40dp" android:padding="9dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_output" android:scaleType="fitCenter" android:contentDescription="Громкость звука" />
    </LinearLayout>
</LinearLayout>
